+/*
+ * NOVA3 Android build: QEMU_SYSCALL_STATS=1 prints, every 10 seconds, how many guest
+ * syscalls of each kind ran. Every guest syscall leaves translated code for the main
+ * loop, so a busy one is a cost of its own; this says which ones are worth a fast path.
+ */
+static int nova3_sc_stats = -1;
+static uint32_t nova3_sc_count[1024];
+static int64_t nova3_sc_t0;
+
+static void nova3_syscall_stats(int num, abi_long path_arg)
+{
+    if (nova3_sc_stats < 0) {
+        const char *v = getenv("QEMU_SYSCALL_STATS");
+        nova3_sc_stats = v && *v && *v != '0';
+        nova3_sc_t0 = g_get_monotonic_time();
+    }
+    if (!nova3_sc_stats) {
+        return;
+    }
+    qatomic_inc(&nova3_sc_count[num & 1023]);
+    /* A sample of the paths behind the busiest file syscalls. */
+    if (path_arg) {
+        static uint32_t seen;
+        if (qatomic_fetch_inc(&seen) % 500 == 0) {
+            char *p = lock_user_string(path_arg);
+            if (p) {
+                fprintf(stderr, "QEMU_SYSCALL_STATS: syscall %d path '%.200s'\n", num, p);
+                unlock_user(p, path_arg, 0);
+            }
+        }
+    }
+    int64_t now = g_get_monotonic_time();
+    if (now - nova3_sc_t0 < 10 * G_USEC_PER_SEC) {
+        return;
+    }
+    nova3_sc_t0 = now;
+    uint32_t total = 0;
+    for (int i = 0; i < 1024; i++) {
+        total += nova3_sc_count[i];
+    }
+    fprintf(stderr, "QEMU_SYSCALL_STATS: %u syscalls/10s, top:", total);
+    for (int k = 0; k < 10; k++) {
+        int best = -1;
+        for (int i = 0; i < 1024; i++) {
+            if (nova3_sc_count[i] && (best < 0 || nova3_sc_count[i] > nova3_sc_count[best])) {
+                best = i;
+            }
+        }
+        if (best < 0) {
+            break;
+        }
+        fprintf(stderr, " %d=%u", best, nova3_sc_count[best]);
+        nova3_sc_count[best] = 0;
+    }
+    memset(nova3_sc_count, 0, sizeof(nova3_sc_count));
+    fprintf(stderr, "\n");
+}
