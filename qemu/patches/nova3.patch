+/*
+ * NOVA3 Android build: the indirect-branch lookup for A32 user-mode code.
+ *
+ * Every return (bx lr, pop {pc}) and call through a pointer ends a TB in
+ * lookup_tb_ptr, and a C++ engine makes tens of millions of them a second.
+ * The generic helper calls get_tb_cpu_state through a function pointer and
+ * curr_cflags in another unit before it even looks at the jump cache; here
+ * the A32 flags are assembled inline and only a jump-cache miss (or anything
+ * unusual: AArch64, M-profile, single-step, breakpoints) takes the generic
+ * path, which also refills the cache.
+ */
+#if defined(CONFIG_USER_ONLY)
+#include "accel/tcg/tb-jmp-cache.h"
+#include "exec/translation-block.h"
+#include "exec/helper-proto-common.h"
+#endif
+
+const void *HELPER(arm_lookup_tb_ptr)(CPUARMState *env)
+{
+#if defined(CONFIG_USER_ONLY)
+    CPUState *cs = env_cpu(env);
+    CPUARMTBFlags flags = env->hflags;
+
+    if (likely(!EX_TBFLAG_ANY(flags, AARCH64_STATE) &&
+               !EX_TBFLAG_ANY(flags, SS_ACTIVE) &&
+               !arm_feature(env, ARM_FEATURE_M) &&
+               !cpu_single_stepping(cs) &&
+               QTAILQ_EMPTY(&cs->breakpoints))) {
+        vaddr pc = env->regs[15];
+        uint32_t cflags = cs->tcg_cflags;
+        CPUJumpCache *jc = cs->tb_jmp_cache;
+        unsigned h = (pc ^ (pc >> TB_JMP_CACHE_BITS)) & (TB_JMP_CACHE_SIZE - 1);
+        TranslationBlock *tb;
+
+        DP_TBFLAG_A32(flags, VECLEN, env->vfp.vec_len);
+        DP_TBFLAG_A32(flags, VECSTRIDE, env->vfp.vec_stride);
+        if (env->vfp.xregs[ARM_VFP_FPEXC] & (1 << 30)) {
+            DP_TBFLAG_A32(flags, VFPEN, 1);
+        }
+        DP_TBFLAG_AM32(flags, THUMB, env->thumb);
+        DP_TBFLAG_AM32(flags, CONDEXEC, env->condexec_bits);
+
+        tb = qatomic_read(&jc->array[h].tb);
+        if (likely(tb && jc->array[h].pc == pc &&
+                   tb->cs_base == flags.flags2 && tb->flags == flags.flags &&
+                   tb_cflags(tb) == cflags)) {
+            cs->neg.can_do_io = true;
+            return tb->tc.ptr;
+        }
+    }
+#endif
+    return helper_lookup_tb_ptr(env);
+}
