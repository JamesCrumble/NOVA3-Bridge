 static inline float32 h32f(float f) { float32 x; memcpy(&x, &f, 4); return x; }
 
+#ifdef NOVA3_NEON_NOFPCR
+/*
+ * Variant without the FPCR switch (-DNOVA3_NEON_NOFPCR).
+ *
+ * Switching the host FPCR to FZ+DN costs a serialising MSR on entry and another
+ * when scalar VFP code runs next, and guest code that mixes the two - a Neon
+ * routine called from VFP code - pays both on every call. Here the element is
+ * computed with the host FPCR left at its IEEE default, which gives the
+ * standard-FPSCR result whenever flush-to-zero and default-NaN have nothing to
+ * do: no operand is a denormal or a NaN, and no result (the product included,
+ * for multiply-accumulate) is a denormal. A result exactly at the smallest
+ * normal is also sent to softfloat, since Arm detects tininess before rounding
+ * and such a value may have been rounded up from below. An invalid operation on
+ * ordinary operands yields the default NaN on the host too. Everything else
+ * goes through neon_f32_std(), so the result is the same in every case.
+ */
+static inline bool f32_plain(float32 v)
+{
+    uint32_t m = float32_val(v) & 0x7fffffff;
+    return m == 0 || (m - 0x00800000u) <= 0x7f000000u;   /* zero, normal or infinity */
+}
+
+static inline bool f32_settled(float r)
+{
+    uint32_t m = float32_val(h32f(r)) & 0x7fffffff;
+    return (m - 1u) >= 0x00800000u;                      /* not in (0, smallest normal] */
+}
+
+static inline float hadd(float x, float y) { float r; asm("fadd %s0, %s1, %s2" : "=w"(r) : "w"(x), "w"(y)); return r; }
+static inline float hsub(float x, float y) { float r; asm("fsub %s0, %s1, %s2" : "=w"(r) : "w"(x), "w"(y)); return r; }
+static inline float hmul(float x, float y) { float r; asm("fmul %s0, %s1, %s2" : "=w"(r) : "w"(x), "w"(y)); return r; }
+
+enum { NF_ADD, NF_SUB, NF_MUL, NF_MLA, NF_MLS };
+#define NFK_gvec_fadd_s         NF_ADD
+#define NFK_gvec_fsub_s         NF_SUB
+#define NFK_gvec_fmul_s         NF_MUL
+#define NFK_gvec_fmla_nf_s      NF_MLA
+#define NFK_gvec_fmls_nf_s      NF_MLS
+#define NFK_gvec_fmul_idx_s     NF_MUL
+#define NFK_gvec_fmla_nf_idx_s  NF_MLA
+#define NFK_gvec_fmls_nf_idx_s  NF_MLS
+
+/* d = n op m, or d = d +- n * m (two rounded steps). False: take the softfloat path. */
+static inline __attribute__((always_inline)) bool
+neon_f32_host(int kind, float32 dd, float32 nn, float32 mm, float32 *out)
+{
+    float r;
+    if (unlikely(!(f32_plain(nn) && f32_plain(mm)))) {
+        return false;
+    }
+    switch (kind) {
+    case NF_ADD: r = hadd(f32h(nn), f32h(mm)); break;
+    case NF_SUB: r = hsub(f32h(nn), f32h(mm)); break;
+    case NF_MUL: r = hmul(f32h(nn), f32h(mm)); break;
+    default:
+        if (unlikely(!f32_plain(dd))) {
+            return false;
+        }
+        r = hmul(f32h(nn), f32h(mm));
+        if (unlikely(!f32_settled(r))) {
+            return false;
+        }
+        r = kind == NF_MLA ? hadd(f32h(dd), r) : hsub(f32h(dd), r);
+        break;
+    }
+    if (unlikely(!f32_settled(r))) {
+        return false;
+    }
+    *out = h32f(r);
+    return true;
+}
+
+/*
+ * The rare element: computed the way the switching variant computes every element, with the host
+ * FPCR set to FZ+DN for this one operation and put back. Not softfloat: its float32_* entry points
+ * take this build's host-FPU shortcut, which is not exact at the smallest normal.
+ */
+static float32 __attribute__((noinline))
+neon_f32_std(int kind, float32 dd, float32 nn, float32 mm)
+{
+    uint64_t old, v;
+    float r;
+    asm volatile("mrs %0, fpcr" : "=r"(old) : : "memory");
+    v = (old & ~(3ull << 22)) | (1ull << 24) | (1ull << 25);  /* RN, FZ, DN */
+    asm volatile("msr fpcr, %0" : : "r"(v) : "memory");
+    switch (kind) {
+    case NF_ADD: r = hadd(f32h(nn), f32h(mm)); break;
+    case NF_SUB: r = hsub(f32h(nn), f32h(mm)); break;
+    case NF_MUL: r = hmul(f32h(nn), f32h(mm)); break;
+    case NF_MLA: r = hadd(f32h(dd), hmul(f32h(nn), f32h(mm))); break;
+    default:     r = hsub(f32h(dd), hmul(f32h(nn), f32h(mm))); break;
+    }
+    asm volatile("msr fpcr, %0" : : "r"(old) : "memory");
+    return h32f(r);
+}
