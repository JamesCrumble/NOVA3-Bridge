/ctl/
/logs/
/donor/
/session-files/
# Build outputs
/qemu/obj-*/
/qemu/out/
/qemu/orig/
/qemu/*.log
/qemu/.build_variant_lf.sh
/tools/restructure.sh
/tools/fix_paths.py
__pycache__/
*.apk
*.idsig
/scratch/
/release/
/port/android/build/release.*
release.pass
# Game files are the player's own (never committed)
/gamebin/
